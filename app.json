{
  "expo": {
    "name": "Tunes",
    "slug": "tunes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tunes",
    "icon": "./assets/images/icon.png",
    "android": {
      "backgroundColor": "#000000",
      "package": "com.vandam.tunes",
      "permissions": ["android.permission.WRITE_SECURE_SETTINGS"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PublicSans-Regular.ttf"
          ]
        }
      ],
      "./plugins/withAndroidConfigChanges",
      "./plugins/withAndroidTheme",
      "./plugins/withDaltonizerToggle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
