{
  "expo": {
    "name": "Reverb",
    "slug": "reverb",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "reverb",
    "icon": "./assets/images/icon.png",
    "android": {
      "backgroundColor": "#000000",
      "package": "com.vandam.reverb",
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_SECURE_SETTINGS",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/PublicSans-Regular.ttf"]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Reverb to access your photos for playlist covers.",
          "granularPermissions": ["photo"]
        }
      ],
      "./plugins/withAndroidConfigChanges",
      "./plugins/withAndroidTheme",
      "./plugins/withDaltonizerToggle",
      "expo-sqlite",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb97c696-b6a2-4e29-9816-3f905027677d"
      }
    }
  }
}
